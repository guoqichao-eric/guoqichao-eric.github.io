        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    %% 样式定义\n    classDef output fill:#e53935,color:#fff,stroke:#b71c1c,stroke-width:2px;\n    classDef ability fill:#1e88e5,color:#fff,stroke:#0d47a1,stroke-width:2px;\n    classDef carrier fill:#fdd835,color:#333,stroke:#f57f17,stroke-width:2px;\n    classDef support fill:#43a047,color:#fff,stroke:#1b5e20,stroke-width:2px;\n    classDef throughout fill:#8e24aa,color:#fff,stroke:#4a148c,stroke-width:2px,stroke-dasharray: 5 5;\n\n    %% ========== 顶层：就业出口（核心目标） ==========\n    subgraph OUT[🎯 L5 - 就业出口层（以终为始的终点）]\n        direction LR\n        O1[安全产品售前工程师]\n        O2[网络与安全运维工程师]\n        O3[渗透测试工程师]\n        O4[安全运营中心分析师]\n        O5[安全评估与等保测评师]\n        O6[AI安全/云安全工程师&lt;br&gt;（新兴岗位）]\n    end\n\n    %% ========== 第二层：能力解构层 ==========\n    subgraph AB[🧩 L4 - 能力解构层（岗位胜任力模型）]\n        direction LR\n        A1[售前能力：&lt;br&gt;方案撰写 / 产品演示 / 客户沟通]\n        A2[运维能力：&lt;br&gt;网络配置 / 防火墙策略 / 故障排查]\n        A3[攻防能力：&lt;br&gt;漏洞挖掘 / 渗透测试 / 代码审计]\n        A4[运营能力：&lt;br&gt;安全监控 / 事件研判 / 应急响应]\n        A5[评估能力：&lt;br&gt;风险评估 / 等级保护 / 合规检查]\n        A6[前沿能力：&lt;br&gt;AI安全 / 云原生安全 / 数据安全]\n    end\n\n    %% ========== 第三层：培养载体层 ==========\n    subgraph CA[📚 L3 - 培养载体层（怎么培养这些能力）]\n        direction LR\n        C1[课程体系：&lt;br&gt;五阶递进课程&lt;br&gt;（通识→平台→岗位→拓展→职场）]\n        C2[实训项目：&lt;br&gt;靶场实战 / 应急演练 / 综合攻防]\n        C3[竞赛机制：&lt;br&gt;校赛 / CTF / 职业技能大赛]\n        C4[认证衔接：&lt;br&gt;CISP/NISP / 华为/深信服认证]\n        C5[顶岗实习：&lt;br&gt;真实岗位 / 企业导师带教]\n    end\n\n    %% ========== 第四层：基础支撑层 ==========\n    subgraph BS[🖥️ L2 - 基础支撑层（用什么平台和资源来教）]\n        direction LR\n        B1[硬件设施：&lt;br&gt;防火墙/IDS/服务器/网络靶场]\n        B2[数字资源：&lt;br&gt;教学案例库 / 虚拟仿真软件]\n        B3[师资团队：&lt;br&gt;双师型教师 / 企业产业导师]\n        B4[合作生态：&lt;br&gt;产业学院 / 政行企校协同]\n    end\n\n    %% ========== 贯穿层 ==========\n    subgraph TH[⚖️ L1 - 贯穿保障层（横切所有层级的基线）]\n        direction LR\n        T1[❤️ 思政育人：总体国家安全观 / 职业道德 / 法律底线]\n        T2[📋 标准规范：教育部教学标准 / 实训条件标准 / 等保合规]\n    end\n\n    %% ========== 连接逻辑（自下而上支撑） ==========\n    BS --&gt;|物质与生态保障| CA\n    CA --&gt;|知识与技能输入| AB\n    AB --&gt;|胜任力匹配| OUT\n\n    %% 贯穿层融入\n    TH -.-&gt;|价值引领与规范约束| BS\n    TH -.-&gt; CA\n    TH -.-&gt; AB\n    TH -.-&gt; OUT\n\n    %% 右侧标注反向逻辑（以终为始）\n    OUT -.-&gt;|逆向驱动| AB\n    AB -.-&gt;|逆向驱动| CA\n    CA -.-&gt;|逆向驱动| BS&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Oz5TPtnrnUrGhkk3YbHM-34">
